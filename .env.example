# Bailanysta — Environment Variables Template
# Скопируй в .env и заполни реальными значениями. Никогда не коммить .env в Git!
# См. README.md и ARCHITECTURE.md для описаний.

# ── App ──
APP_NAME=Bailanysta
APP_ENV=development
# development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Backend ──
# Host/port для локальной разработки
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Database (PostgreSQL — production & local dev) ──
# Формат: postgresql+psycopg://user:password@host:5432/db
# psycopg[binary] — современный драйвер для SQLAlchemy 2.x (не psycopg2)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bailanysta
# Docker Compose (локально):
POSTGRES_DB=bailanysta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ── Security / Auth ──
# Сгенерируй: openssl rand -hex 32  (или python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──
# Список разрешённых origins через запятую (без пробелов или с пробелами — парсится)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# В production: https://bailanysta.vercel.app,https://api.bailanysta.com

# ── Frontend ──
# Публичный URL бэкенда, доступен в браузере (только VITE_ переменные попадают в bundle!)
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Bailanysta

# ── Storage / Uploads ──
# Локально: ./uploads  |  Prod: S3/R2 bucket
STORAGE_TYPE=local
# local | s3 | r2
STORAGE_LOCAL_PATH=./uploads
# S3 / R2 (заполнять только если STORAGE_TYPE=s3/r2)
# STORAGE_BUCKET=bailanysta-media
# STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_URL=https://media.bailanysta.com

# Upload limits (MB)
MAX_AVATAR_SIZE_MB=2
MAX_POST_IMAGE_SIZE_MB=5
MAX_STORY_MEDIA_SIZE_MB=10

# ── Rate Limiting ──
RATE_LIMIT_AUTH_LOGIN=5/minute
RATE_LIMIT_POST_CREATE=10/hour

# ── Optional / Future ──
# REDIS_URL=redis://localhost:6379/0
# SENTRY_DSN=
# LOG_LEVEL=info
